{
  "manifestVersion": 5,
  "id": "dev.halation.photoshop",
  "name": "Halation",
  "version": "1.1.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "halationPanel",
      "label": {
        "default": "Halation"
      },
      "minimumSize": { "width": 260, "height": 420 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 300, "height": 760 },
      "preferredFloatingSize": { "width": 320, "height": 800 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ]
}
